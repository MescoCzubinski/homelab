{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Warsaw",
  "dependencyDashboardApproval": false,
  "minimumReleaseAge": "3 days",
  "schedule": ["before 6am on monday"],
  "kubernetes": {
    "managerFilePatterns": [
      "/^tools/.+\\.ya?ml$/",
      "/^infra/cloudflared/.+\\.ya?ml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": ["/^infra/argocd/applications/.+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "Group the beszel hub and agent images",
      "matchPackageNames": ["henrygd/beszel", "henrygd/beszel-agent"],
      "groupName": "beszel"
    },
    {
      "description": "Image tags in apps/ are owned by Argo CD Image Updater",
      "matchFileNames": ["apps/**"],
      "enabled": false
    },
    {
      "description": "Skip patch bumps",
      "matchUpdateTypes": ["patch"],
      "enabled": false
    },
    {
      "description": "Samba tags look like smbd-only-a<alpine>-s<samba>-r<rev>; track the samba version",
      "matchPackageNames": ["ghcr.io/servercontainers/samba"],
      "versioning": "regex:^smbd-only-a\\d+\\.\\d+\\.\\d+-s(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-r(?<build>\\d+)$",
      "matchUpdateTypes": ["major", "minor"],
      "enabled": true
    }
  ],
  "semanticCommits": "disabled",
  "commitMessageAction": "",
  "commitMessageTopic": "{{{replace \"^.*/\" \"\" depName}}}:",
  "commitMessageExtra": "{{{replace \"^v?\" \"v\" newVersion}}}"
}
